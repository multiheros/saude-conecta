# Copie para .env e troque os valores. O .env nao e versionado.
# Sem .env, o Compose usa padroes de desenvolvimento.
PACIENTES_DB_USER=pacientes
PACIENTES_DB_PASSWORD=troque-me-pacientes
AGENDAMENTO_DB_USER=agendamento
AGENDAMENTO_DB_PASSWORD=troque-me-agendamento
AGENDAMENTO_LEITURA_USER=leitura
AGENDAMENTO_LEITURA_PASSWORD=troque-me-leitura
AGENDAMENTO_CACHE_PASSWORD=troque-me-cache
TRIAGEM_DB_USER=triagem
TRIAGEM_DB_PASSWORD=troque-me-triagem
NOTIFICACOES_DB_PASSWORD=troque-me-notificacoes
RABBITMQ_USER=saude
RABBITMQ_PASSWORD=troque-me-rabbit
# Chave do Google AI Studio (https://aistudio.google.com/apikey). Sem ela, a triagem trabalha por regras.
GEMINI_API_KEY=
# Opcional; padrao gemini-3.5-flash-lite
LLM_MODELO=
# Senha dos usuarios ficticios de demonstracao
SEED_SENHA=demo12345
